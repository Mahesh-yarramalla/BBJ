generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  description      String
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  imageUrl         String
  imageAlt         String
  preparationHours Int              @default(4)
  featured         Boolean          @default(false)
  tags             String[]         @default([])
  isActive         Boolean          @default(true)
  variants         ProductVariant[]
  images           ProductImage[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId, isActive])
  @@index([featured, isActive])
  @@index([name])
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  name               String              @default("Default")
  sku                String              @unique
  unit               String
  pricePaise         Int
  stockQuantity      Int                 @default(0)
  isDefault          Boolean             @default(true)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([productId, isActive])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model DeliveryZone {
  id               String                 @id @default(cuid())
  name             String
  city             String                 @default("Coimbatore")
  state            String                 @default("Tamil Nadu")
  country          String                 @default("India")
  isActive         Boolean                @default(false)
  deliveryFeePaise Int                    @default(0)
  minOrderPaise    Int                    @default(0)
  postcodes        DeliveryZonePostcode[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  orders           Order[]

  @@index([city, state, isActive])
}

model DeliveryZonePostcode {
  id             String       @id @default(cuid())
  postcode       String
  deliveryZoneId String
  deliveryZone   DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([postcode, deliveryZoneId])
  @@index([postcode])
}

model PickupLocation {
  id           String   @id @default(cuid())
  name         String
  addressLine1 String?
  addressLine2 String?
  city         String   @default("Coimbatore")
  state        String   @default("Tamil Nadu")
  postcode     String?
  phone        String?
  openingHours Json?
  instructions String?
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]

  @@index([city, isActive])
}

model FulfillmentSlot {
  id         String          @id @default(cuid())
  type       FulfillmentType
  label      String
  startTime  String
  endTime    String
  weekdays   Int[]           @default([1, 2, 3, 4, 5, 6, 0])
  capacity   Int             @default(10)
  cutOffTime String          @default("14:00")
  isActive   Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  orders     Order[]

  @@index([type, isActive])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum InventoryMovementReason {
  ORDER_RESERVED
  ORDER_CANCELLED
  RESTOCK
  MANUAL_ADJUSTMENT
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  status          OrderStatus     @default(PENDING)
  fulfillmentType FulfillmentType

  // Customer details captured when the order is placed
  customerName  String
  customerEmail String?
  customerPhone String

  // Delivery or pickup selection
  deliveryZoneId String?
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)

  pickupLocationId String?
  pickupLocation   PickupLocation? @relation(fields: [pickupLocationId], references: [id], onDelete: Restrict)

  fulfillmentSlotId String?
  fulfillmentSlot   FulfillmentSlot? @relation(fields: [fulfillmentSlotId], references: [id], onDelete: Restrict)

  // Address snapshot: populated for delivery orders
  deliveryAddress1 String?
  deliveryAddress2 String?
  deliveryCity     String?
  deliveryState    String?
  deliveryPostcode String?

  scheduledFor  DateTime?
  customerNotes String?

  // All monetary amounts are integer paise
  subtotalPaise    Int
  deliveryFeePaise Int @default(0)
  discountPaise    Int @default(0)
  totalPaise       Int

  items              OrderItem[]
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerPhone, createdAt])
  @@index([fulfillmentType, scheduledFor])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  // Preserve what was purchased, even if catalog details later change
  productName String
  variantName String
  sku         String
  unit        String

  quantity       Int
  unitPricePaise Int
  lineTotalPaise Int

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productVariantId])
}

model InventoryMovement {
  id               String         @id @default(cuid())
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Negative means stock was deducted; positive means stock was restored
  quantityDelta Int
  reason        InventoryMovementReason
  note          String?

  createdAt DateTime @default(now())

  @@index([productVariantId, createdAt])
  @@index([orderId])
}
